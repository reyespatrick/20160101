{
  "name": "immoba",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Vue 3 PWA that lists properties from the Inmovilla CRM through a small proxy server",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "node --env-file-if-exists=.env server/index.js",
    "dev:mock": "cross-env INMOVILLA_MOCK=1 npm run dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "vitest run",
    "icons": "node scripts/generate-icons.mjs",
    "predev:mock": "node scripts/generate-mock-photos.mjs --if-missing",
    "mock:photos": "node scripts/generate-mock-photos.mjs",
    "mock:inmovilla": "node scripts/mock-inmovilla.mjs",
    "dev:pages": "concurrently -k \"npm:mock:inmovilla\" \"wrangler pages dev dist --port 8788 --compatibility-date=2026-09-01 --compatibility-flags=nodejs_compat\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@supabase/supabase-js": "^2.116.0",
    "express": "^5.2.1",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.10",
    "vue-router": "^5.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "sharp": "^0.35.4",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  }
}
