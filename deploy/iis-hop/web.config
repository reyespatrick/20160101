<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS application hosting only the apiweb hop (apiweb.ashx). Create an application under an existing
  site (e.g. projects.digitalpencorp.ch/immoba-hop) pointing at the folder that holds this file and
  apiweb.ashx, with an application pool on .NET Framework v4.x (integrated pipeline).
  Set HopSecret to a long random value and give the same value to the Pages Function secret
  APIWEB_HOP_SECRET (or to the Node relay's env).
-->
<configuration>
  <appSettings>
    <add key="HopSecret" value="CHANGE_ME_LONG_RANDOM" />
    <add key="MaxPerMinute" value="60" />
    <add key="ApiwebUrl" value="https://apiweb.inmovilla.com/apiweb/apiweb.php" />
  </appSettings>
  <system.web>
    <!-- 4.6.1 runs on any current Windows Server; raise it if you want, never above the installed version -->
    <compilation targetFramework="4.6.1" debug="false" />
    <httpRuntime targetFramework="4.6.1" maxRequestLength="64" />
    <!-- Off shows the real error in the browser while you set the hop up; switch to "On" once it answers -->
    <customErrors mode="Off" />
  </system.web>
  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="65536" />
      </requestFiltering>
    </security>
    <!--
      Without this, IIS replaces the handler's own error body with its standard HTML page, so a
      rejected call reads as a bare "403 Forbidden" and the reason is invisible. PassThrough keeps
      the handler's JSON ({"error":"hop secret missing or wrong"}), which is what you need to tell a
      wrong secret from a blocked request.
    -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
