# /etc/immoba/env — environment of the immoba systemd service (chmod 600, owned by root)
PORT=3000
DATA_DIR=/var/lib/immoba
PHOTOS_DIR=/var/lib/immoba/photos
PHOTO_TTL_DAYS=30
# Public address Inmovilla uses to download photos (your Caddy domain)
PUBLIC_URL=https://DOMAIN
# Long random secret: signs sessions and encrypts the agencies' keys. Generated by setup.sh; never change it
# afterwards or every stored key becomes unreadable.
APP_SECRET=CHANGE_ME
# Required to create a second agency on this server (leave empty to allow anyone with the URL)
SIGNUP_CODE=
INMOVILLA_API_URL=https://apiweb.inmovilla.com/apiweb/apiweb.php
INMOVILLA_REST_URL=https://procesos.inmovilla.com/api/v1
INMOVILLA_DOMAIN=
INMOVILLA_MOCK=0
