<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS site configuration for Immoba: reverse proxy every request to the Node relay on localhost:3000.
  Requires the IIS modules "URL Rewrite" and "Application Request Routing" (ARR) with the proxy enabled
  at server level (see deploy/windows-iis.md). Copy this file to the site's physical folder.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Immoba relay" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://localhost:3000/{R:1}" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
          </serverVariables>
        </rule>
      </rules>
      <outboundRules>
        <!-- keep the relay's own Cache-Control headers untouched -->
      </outboundRules>
    </rewrite>
    <security>
      <requestFiltering>
        <!-- listing photos are up to 8 MB each; the REST relay body is capped at 12 MB by the app -->
        <requestLimits maxAllowedContentLength="16000000" />
      </requestFiltering>
    </security>
    <!-- IIS must not cache or compress the API responses itself -->
    <urlCompression doStaticCompression="false" doDynamicCompression="false" />
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
