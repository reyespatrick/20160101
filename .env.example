# Port for the relay/static server
PORT=3000

# Inmovilla legacy "apiweb" endpoint (read: listings). Requires the server IP to be whitelisted by Inmovilla.
INMOVILLA_API_URL=https://apiweb.inmovilla.com/apiweb/apiweb.php

# Domain sent as "elDominio" (the domain Inmovilla has authorised for your agency)
INMOVILLA_DOMAIN=

# Inmovilla REST API v1 base URL (write: clients, listings, photos). The user's token is sent per request.
INMOVILLA_REST_URL=https://procesos.inmovilla.com/api/v1

# Set to 1 to serve sample data and an in-memory fake REST API instead of calling Inmovilla
# (login with agency 1234 / key "demo" / REST token "demo-token")
INMOVILLA_MOCK=0
