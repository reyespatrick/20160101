# Port for the proxy/static server
PORT=3000

# Upstream Inmovilla API endpoint (legacy "apiweb" JSON API)
INMOVILLA_API_URL=https://apiweb.inmovilla.com/apiweb/apiweb.php

# Domain sent as "elDominio" (the domain Inmovilla has authorised for your agency)
INMOVILLA_DOMAIN=

# Set to 1 to serve sample data instead of calling Inmovilla (useful for local development)
INMOVILLA_MOCK=0

# Secret used to sign session tokens for the clients API (set a long random string in production)
APP_SECRET=

# Directory where the clients database (clients.json) is stored
DATA_DIR=./data
