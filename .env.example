# Port for the relay/static server
PORT=3000

# Inmovilla legacy "apiweb" endpoint (read: listings). No IP allow list, but Inmovilla blocks a caller's IP
# for 10 minutes at 70 requests/minute (permanently after 10 blocks), so the relay caps its own rate.
INMOVILLA_API_URL=https://apiweb.inmovilla.com/apiweb/apiweb.php
APIWEB_MAX_PER_MIN=60

# Domain sent as "elDominio" (the domain Inmovilla has authorised for your agency)
INMOVILLA_DOMAIN=

# Inmovilla REST API v1 base URL (write: clients, listings, photos). The user's token is sent per request.
INMOVILLA_REST_URL=https://procesos.inmovilla.com/api/v1

# Set to 1 to serve sample data and an in-memory fake REST API instead of calling Inmovilla.
# In mock mode the admin sets these Inmovilla keys in the profile: agency 1234 / web key "demo" / REST token "demo-token"
INMOVILLA_MOCK=0

# Accounts database (agencies, users, encrypted Inmovilla keys): DATA_DIR/immoba.sqlite
DATA_DIR=./data
# Secret for session signing and key encryption. Set a long random string in production;
# if missing, one is generated and stored in DATA_DIR/secret.key (keep that file!)
APP_SECRET=
# Optional: after the first agency, require this code to create further agencies (multi-agency hosting)
SIGNUP_CODE=
# Fake listing photos for the mock (create them with: node scripts/generate-mock-photos.mjs)
MOCK_PHOTOS_DIR=./data/mock-photos

# Photo hosting (Inmovilla downloads listing photos from public URLs, so the relay hosts them briefly)
# Public base URL of this server as reachable by Inmovilla, e.g. https://alma.example.com (defaults to the request host)
PUBLIC_URL=
PHOTOS_DIR=./data/photos
PHOTO_TTL_DAYS=30
