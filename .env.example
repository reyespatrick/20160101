# Port for the proxy/static server
PORT=3000

# Upstream Inmovilla API endpoint (legacy "apiweb" JSON API)
INMOVILLA_API_URL=https://apiweb.inmovilla.com/apiweb/apiweb.php

# Domain sent as "elDominio" (the domain Inmovilla has authorised for your agency)
INMOVILLA_DOMAIN=

# Set to 1 to serve sample data instead of calling Inmovilla (useful for local development)
INMOVILLA_MOCK=0

# Secret used to sign session tokens for the clients API (set a long random string in production)
APP_SECRET=

# Directory where the clients database (clients.json) is stored
DATA_DIR=./data

# Inmovilla REST API v1 (write access): everything created in the app is forwarded there.
# Generate the token in Inmovilla: Configuración > Opciones > Token API Rest.
INMOVILLA_REST_URL=https://procesos.inmovilla.com/api/v1
INMOVILLA_REST_TOKEN=
# Set to 1 to simulate the forwarding without calling Inmovilla (automatically on with INMOVILLA_MOCK=1)
INMOVILLA_REST_DRY_RUN=0
# Endpoint paths, to adjust if the REST documentation differs (see server/inmovillaMapping.js)
# INMOVILLA_REST_PATH_PROPERTIES=/propiedades
# INMOVILLA_REST_PATH_PHOTOS=/propiedades/{id}/fotos
# INMOVILLA_REST_PATH_CLIENTS=/clientes
